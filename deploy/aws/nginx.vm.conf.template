# nginx for the AWS demonstration VM. deploy/aws/bringup.sh replaces __APP_HOST__ and writes the result to
# /opt/arai/nginx.conf, which compose.vm.yml mounts into the web container. certbot keeps the certificate under
# live/__APP_HOST__/.
#
# Access (D-044 as amended on 18 Oct 2026, final-spec/DECISIONS.md AM-73 and AM-74): the UI is public, no IP allowlist
# and no Keycloak. What protects it: TLS, the shared login checked inside the API (BASIC_AUTH_*), the development
# login's personas and roles for every action, and the request limits below.

limit_req_zone $binary_remote_addr zone=arai_api:10m rate=20r/s;     # per address; a browser session needs far less
limit_req_zone $binary_remote_addr zone=arai_auth:10m rate=10r/m;    # sign-in: slows guessing of the shared login
limit_conn_zone $binary_remote_addr zone=arai_conn:10m;

# 80: the certificate challenge and the redirect, nothing else (the security group opens 80 to everyone for this).
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# 443 with an unknown name: close the connection (no default certificate games).
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    return 444;
}

# UI and API, public.
server {
    listen 443 ssl;
    http2 on;
    server_name __APP_HOST__;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    client_max_body_size 520m;            # the upload limit is 500,000,000 bytes; the API enforces it exactly
    limit_conn arai_conn 20;

    location /api/v1/auth/ {
        limit_req zone=arai_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }
    location /api/ {
        limit_req zone=arai_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;        # client-side routes
    }
}
