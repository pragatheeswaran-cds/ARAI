# nginx for the AWS demonstration VM. deploy/aws/bringup.sh replaces __APP_HOST__, __API_HOST__ and __AUTH_HOST__ and
# writes the result to /opt/arai/nginx.conf, which compose.vm.yml mounts into the web container.
# One Let's Encrypt certificate covers the three names; certbot keeps it under live/__APP_HOST__/.

# 80: the certificate challenge and the redirect, nothing else (the security group opens 80 to everyone for this).
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# 443 with an unknown name: close the connection (no default certificate games).
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    return 444;
}

# UI and API for people on the allowlist (D-044). The allowlist file holds one "allow <ip>;" per line.
server {
    listen 443 ssl;
    http2 on;
    server_name __APP_HOST__;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/arai-allowlist.conf;
    deny all;
    client_max_body_size 520m;            # the upload limit is 500,000,000 bytes; the API enforces it exactly

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;        # client-side routes
    }
}

# API only: the upstream of the Vercel rewrite. No allowlist (Vercel's addresses are not fixed); the shared login and
# the sign-in protect it, as D-044 amended for the Vercel address records. Not a UI: / answers 404.
server {
    listen 443 ssl;
    http2 on;
    server_name __API_HOST__;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 520m;

    location /api/ {
        proxy_pass http://api_vercel:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
    location / { return 404; }
}

# Keycloak. Open to everyone who reaches the sign-in redirect; Keycloak's own login protects it.
server {
    listen 443 ssl;
    http2 on;
    server_name __AUTH_HOST__;
    ssl_certificate /etc/letsencrypt/live/__APP_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://keycloak:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
