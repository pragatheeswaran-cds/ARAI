# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# local: no login, loopback only.  vm: every request needs the shared login below (behind a TLS reverse proxy).
APP_PROFILE=local
UI_ORIGINS=http://localhost:8080
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Sign-in (RUNBOOK 2.5 and 2.6). Empty AUTH_MODE: the development login on local, Keycloak single sign-on on vm.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://keycloak.example.org/realms/arai
# OIDC_CLIENT_ID=arai
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://arai.example.org/api/v1/auth/callback
# AUTH_ROLE_MAP=arai-viewers=viewer,arai-reviewers=reviewer,arai-approvers=approver,arai-admins=admin
# ARAI_BOOTSTRAP_ADMINS=you@example.org          # admin without a Keycloak group, for the first sign-in
# The development Keycloak (docker compose --profile sso up keycloak) with arai local on port 8000:
# AUTH_MODE=oidc OIDC_ISSUER=http://127.0.0.1:8081/realms/arai OIDC_ALLOW_HTTP=1 OIDC_CLIENT_ID=arai
# OIDC_CLIENT_SECRET=arai-dev-secret OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
# Its admin console (http://127.0.0.1:8081/admin); set before its first start to change the defaults kcadmin / kcadmin-dev:
# KEYCLOAK_ADMIN_USER=kcadmin
# KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev

# Investigation memos (worker only). Without a key every memo is unavailable by design; no call is made.
ANTHROPIC_API_KEY=
# ARAI_MEMO_MODEL=claude-opus-5-5

# Running without Docker (uv run arai serve / worker) reads these instead:
# DATABASE_URL=postgresql://arai:<password>@127.0.0.1:5432/arai
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/arai_local_db?sslmode=require   # Supabase (RUNBOOK 3.2)
# ARTIFACT_ROOT=data/EXP-20261005-04/artifacts     # the default already; set it together with PRIVATE_TRUTH_ROOT or not at all
# PRIVATE_TRUTH_ROOT is used only by the offline commands (generate, train, select, test, publish). Serving never reads it.

# Everything else the code reads, with its default. None needs setting for the demo; listed so nothing is hidden.
# ARAI_DATA_ROOT=data/EXP-20261005-04            # the experiment's data folder (artifacts, private, postgres); default from experiment.yaml data_root
# PRIVATE_TRUTH_ROOT=data/EXP-20261005-04/private
# ARAI_SPEC_ROOT=final-spec                      # the specification the generator and the contracts are read from
# ARAI_ARTIFACTS=./data/EXP-20261005-04/artifacts   # Docker Compose only: the folder mounted into the containers
# AUTH_DEV_USERS=Asha=reviewer,approver;Ravi=reviewer,approver;Meera=reviewer,approver;Arjun=reviewer;Priya=viewer;Admin=admin
# SESSION_IDLE_MINUTES=60                        # signed out after this long without a request
# SESSION_MAX_HOURS=10                           # and after this long in any case
# AUTH_ROLE_CLAIM=groups                         # the token claim holding the Keycloak groups
# OIDC_SCOPES=openid profile email
# OIDC_API_AUDIENCE=arai-api                     # the audience a script's bearer token must carry
# WORKER_ID=worker-1                             # the scoring worker's name in its heartbeat
# ARAI_API=http://127.0.0.1:8000                 # npm run dev only: where the UI development server forwards /api
# ARAI_BROWSER=                                  # tests\e2e scripts only: a Chromium executable instead of the machine's Edge
