# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# local: no login, loopback only.  vm: every request needs the shared login below (behind a TLS reverse proxy).
APP_PROFILE=local
UI_ORIGINS=http://localhost:8080
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Investigation memos (worker only). Without a key every memo is unavailable by design; no call is made.
ANTHROPIC_API_KEY=
# ARAI_MEMO_MODEL=claude-opus-5-5

# Running without Docker (uv run arai serve / worker) reads these instead:
# DATABASE_URL=postgresql://arai:<password>@127.0.0.1:5432/arai
# ARTIFACT_ROOT=data/EXP-20261005-04/artifacts     # the default already; set it together with PRIVATE_TRUTH_ROOT or not at all
# PRIVATE_TRUTH_ROOT is used only by the offline commands (generate, train, select, test, publish). Serving never reads it.
